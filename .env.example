# ============================================================
# TeamSpace 환경변수
#   필수는 DATABASE_URL · AUTH_SECRET 뿐이다.
#   나머지는 전부 선택 — 비워두면 해당 기능만 꺼지고 코어는 동작한다.
# ============================================================

# --- 데이터베이스 (Prisma / postgres) ---
DATABASE_URL=postgresql://teamspace:teamspace@localhost:5433/teamspace

# 데이터 루트 — 문서(docs)·본문 git 저장소(content)·업로드(uploads)가 이 아래에 저장된다.
# 비워두면 기본값 <레포 루트>/data 사용.
TEAMSPACE_DATA_DIR=

# --- Auth.js (NextAuth v5) ---
# AUTH_SECRET: `openssl rand -base64 33` 로 생성 (필수)
AUTH_SECRET=
# tailnet/프록시 환경에서 호스트 신뢰
AUTH_TRUST_HOST=true
# Google OAuth 자격증명 (Google Cloud Console에서 발급).
# 비워두면 Google 로그인 불가 — 데모는 아래 AUTH_OPEN_API 사용.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ingest 엔드포인트(/api/ingest) HMAC 서명 검증용 시크릿.
# 비워두면 AUTH_SECRET 으로 폴백한다(둘 다 없으면 ingest 503).
AUTH_INGEST_SECRET=

# 자동가입 허용 도메인 목록(콤마/공백 구분, 예: example.com,example.org).
# 이메일 도메인이 일치하면 초대 없이 가입 허용. 비워두면 초대 전용 모드.
AUTH_ALLOWED_DOMAINS=

# true 면 인증 없이 API/화면 전체 개방 — 로컬 데모 전용.
# ⚠️ 프로덕션에서는 절대 켜지 말 것. 비워두면(기본) 정상 인증 요구.
AUTH_OPEN_API=

# 외부에서 접근하는 기준 URL (페어링 링크 등에 사용).
# 비워두면 기본값 http://localhost:3002
PUBLIC_BASE_URL=

# --- Slack 연동 (전부 선택 — 비워두면 Slack 기능만 꺼진다) ---
# 봇 토큰(xoxb-…). env 에 있으면 우선 사용, 없으면 설정 화면(DB)에 저장한 토큰 사용.
AUTH_SLACK_BOT_TOKEN=
# Slack 인터랙션(버튼 응답) 서명 검증용 Signing Secret. 비워두면 /api/slack/interactions 503.
AUTH_SLACK_SIGNING_SECRET=
# 기본 발송 채널 ID(C…). 비워두면 설정 화면의 기본 채널로 폴백.
AUTH_SLACK_DEFAULT_CHANNEL=
# 컨펌(slack-confirm) DM 대상 이메일 — 기본 채널이 없을 때 이 사용자에게 DM.
AUTH_SLACK_CONFIRM_EMAIL=

# --- LLM 합성 (전부 선택 — 없으면 추출형 폴백으로 동작) ---
# Anthropic API 키. 있으면 프로바이더 기본값이 api 가 된다.
ANTHROPIC_API_KEY=
# api 프로바이더가 쓸 모델 (기본 claude-sonnet-4-6)
ANTHROPIC_MODEL=
# 프로바이더 강제 지정: api | cli | off
#   미설정 시 키 있으면 api, 없으면 cli(로컬 claude CLI 로그인 사용, 키 불필요).
#   off 로 두면 LLM 합성 비활성(추출형만).
ASK_LLM_PROVIDER=
# cli 프로바이더가 쓸 모델 (기본 claude-haiku-4-5)
ASK_CLAUDE_MODEL=
# cli 호출 타임아웃 ms (기본 120000, 최소 5000)
ASK_CLAUDE_TIMEOUT_MS=

# --- 워커 / CLI / MCP ---
# 워커(scripts/worker.ts) 폴링 주기 ms (기본 60000, 최소 5000)
WORKER_INTERVAL_MS=
# `pnpm ws` CLI·MCP 서버·훅이 호출할 TeamSpace 서버 주소 (기본 http://localhost:3002)
WS_BASE=
# 에이전트 토큰(wst_…) — 설정 화면 › 에이전트 토큰에서 발급.
# 비워두면 ~/.claude/teamspace.json 의 { base, token } 으로 폴백.
WS_TOKEN=

# --- 백업 (scripts/backup.sh / pnpm backup) ---
# 백업 보관 루트. 비워두면 기본값 ~/Backups/teamspace
TEAMSPACE_BACKUP_DIR=

# --- 개발 서버 ---
# next dev 에 접근을 허용할 추가 오리진(콤마 구분, 예: 100.64.0.1,my-host.example.ts.net).
# 비워두면 localhost 만 허용.
ALLOWED_DEV_ORIGINS=
