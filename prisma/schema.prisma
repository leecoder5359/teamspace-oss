// TeamSpace — Prisma schema
// 하이브리드 저장: 문서 본문은 content/ md 파일(소스오브트루스), 여기엔 구조/운영 데이터만.
// docs/PLAN.md §3 참조.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- 사용자 / 워크스페이스 ----------
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String? // @deprecated 미사용 — 읽기·쓰기 0건. 아바타는 Auth.js 의 image 를 쓴다.
  emailVerified DateTime? // Auth.js
  image         String? // Auth.js (OAuth 프로필 이미지)
  createdAt     DateTime  @default(now())

  memberships          WorkspaceMember[]
  agentTokens          AgentToken[]
  createdPages         Page[]            @relation("PageCreatedBy")
  ledProjects          Project[]         @relation("ProjectLead")
  // D3 부여 (받은 것 / 만든 것)
  pageGrants           PageGrant[]       @relation("PageGrantUser")
  projectGrants        ProjectGrant[]    @relation("ProjectGrantUser")
  pageGrantsCreated    PageGrant[]       @relation("PageGrantCreatedBy")
  projectGrantsCreated ProjectGrant[]    @relation("ProjectGrantCreatedBy")

  // Auth.js (NextAuth) 연동
  accounts Account[]
  sessions Session[]

  rowComments RowComment[]
  pairings    Pairing[]
  favorites   PageFavorite[]
  visits      PageVisit[]

  publishedSites PublishedSite[] @relation("SiteCreatedBy")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members        WorkspaceMember[]
  teams          Team[]
  pages          Page[]
  projects       Project[]
  slackInstall   SlackInstall?
  notifRules     NotifRule[]
  notifLogs      NotifLog[]
  schedules      Schedule[]
  claudeSessions ClaudeSession[]
  pushLocks      PushLock[]
  routeRules     WorkspaceRouteRule[]
  agentTokens    AgentToken[]
  approvals      Approval[]
  decisions      Decision[]
  glossary       GlossaryTerm[]
  changelog      ChangelogEntry[]
  risks          Risk[]
  qaScenarios    QaScenario[]
  entities       Entity[]
  dodItems       DodItem[]
  onboarding     OnboardingStep[]
  llmJobs        LlmJob[]
  pairings       Pairing[]
  publishedSites PublishedSite[]
  graphEdges     GraphEdge[]
  envVars        EnvVar[]
  envOps         EnvOp[]
  envTargets     EnvTarget[]
  envAccessLogs  EnvAccessLog[]
}

enum Role {
  admin
  editor
  viewer
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  role        Role      @default(editor)
  status      String    @default("active") // active | invited (초대 후 미수락) | removed (제거됨 — 자동 재가입 차단)
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId      String?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([teamId])
}

// 에이전트별 워크스페이스 스코프 API 토큰 (W1 보안 기반).
// 발급 시 원문(wst_<64hex>)은 1회만 노출하고 sha256 해시만 저장한다.
// 발급과 동시에 에이전트용 시스템 User + WorkspaceMember 가 생성되어
// 작성자 기록(attribution)과 멤버 목록 노출이 사람 팀원과 동일하게 동작한다.
model AgentToken {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String // 이 토큰의 시스템 User (에이전트 신원)
  // 이 토큰을 발급한 사람(User.id). 개인 레슨 주입의 기준 — 에이전트 세션은 발급자의 개인 레슨을 받는다.
  // null = 알 수 없음(이관 전 토큰 중 발급자를 못 찾은 것) → 개인 레슨 없이 동작.
  issuedById  String?
  name        String // 예: "mac-mini-claude"
  tokenHash   String    @unique // sha256(token) hex
  role        Role      @default(editor)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([workspaceId])
}

// ---------- 팀 (워크스페이스 내 멤버 그룹) ----------
model Team {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  name        String
  color       String    @default("blue")
  createdAt   DateTime  @default(now())

  members WorkspaceMember[]

  // D3: 팀 단위 부여 — 팀이 사라지면 부여도 함께 사라진다(Cascade).
  pageGrants    PageGrant[]
  projectGrants ProjectGrant[]

  @@index([workspaceId])
}

// ---------- 프로젝트 (보드/문서를 묶는 작업 영역) ----------
model Project {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  name        String
  short       String? // 짧은 코드 (예: iOS, AOS, CORE)
  color       String    @default("blue") // Saebit accent 키 (blue/orange/purple/green/red…)
  description String?
  repoUrl     String? // 코드 repo URL (카드 링크)
  repoPath    String? // 로컬 절대경로 (git 상태 조회용, 선택)
  repoBranch  String? // 기본 브랜치(선택)
  docsDir     String? // docs/ 아래 문서 폴더명 (예: "teamspace", "crewpool")
  // 기술 스택 태그(소문자, 예: ["next","supabase"]) — Lesson.stack 과 맞으면 그 레슨이 이 프로젝트 세션에 주입된다.
  stack       String[]  @default([])
  lead        User?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // 보관(F10) — null=활성. 삭제와 달리 페이지·지표는 그대로 두고 목록 기본 노출만 뺀다.
  archivedAt  DateTime?

  // 프로젝트 단위 권한 (격차 D3) — 이 프로젝트의 페이지 전체에 적용된다.
  visibility Visibility     @default(inherit)
  grants     ProjectGrant[]

  pages            Page[] // 이 프로젝트에 소속된 보드/문서
  decisions        Decision[]
  risks            Risk[]
  changelogEntries ChangelogEntry[]
  qaScenarios      QaScenario[]

  lessons        Lesson[]
  approvals      Approval[]
  notifRules     NotifRule[]
  proposals      Proposal[]
  publishedSites PublishedSite[]
  envVars        EnvVar[]
  envOps         EnvOp[]
  envTargets     EnvTarget[]

  @@index([workspaceId])
}

// ---------- 페이지 (문서 / 데이터베이스) ----------
enum PageKind {
  doc
  database
}

model Page {
  id          String         @id @default(cuid())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  parent      Page?          @relation("PageTree", fields: [parentId], references: [id])
  parentId    String?
  children    Page[]         @relation("PageTree")
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  kind        PageKind       @default(doc)
  title       String         @default("Untitled")
  icon        String?
  /**
   * 문서 종류(사이드바 아이콘·목록 필터). 폴더 기준이 아니다 — 폴더는 parentId.
   */
  docType     DocType?
  favorites   PageFavorite[]
  visits      PageVisit[]
  position    Int            @default(0)

  // 본문의 소스오브트루스는 content/ 아래 md 파일이다 — 확정(결정 cmshmhos2, 2026-08-06).
  //
  // 종전엔 이 자리에 서로 모순되는 주석 3개가 있었다(파일이 원본 / markdown 은 차후
  // blocks 로 격하 / blocks 가 진실원본). BlockNote 를 편집기로 되살리면서 정리했고,
  // 미사용이던 `blocks` 컬럼은 2026-08-09 에 삭제했다(195행 전부 NULL·참조 0곳):
  // **편집기는 표현 계층일 뿐이고 저장 포맷은 마크다운이다.** 편집기가 바뀌어도
  // 저장물은 그대로 남아야 하고, 파일이면 git·grep·다른 도구가 그대로 쓸 수 있다.
  filePath    String? // 예: content/<workspaceId>/<pageId>.md — 원본
  markdown    String? // 파생 캐시(검색·슬랙·세션 주입). 파일 저장 시 함께 갱신된다.
  contentHash String? // 파일 SHA. **현재 캐시 무효화에 쓰이지 않는다** — 저장 시 채워만 두고
  // 아무도 비교하지 않는다(전수조사 D17). 쓰거나 지우거나 결정 필요.
  archivedAt  DateTime? // 보관(F2) — 휴지통과 달리 지워진 게 아니라 '치워둔' 상태. 사이드바·목록·검색 기본 제외
  deletedAt   DateTime? // 소프트 삭제(휴지통) — DELETE /api/pages 는 소프트, 영구 삭제는 /api/trash purge
  rev         Int       @default(0) // 본문 저장마다 +1 (낙관적 잠금 baseRev 비교 대상)
  inferTriedAt DateTime? // 그래프 연관 추론(POST /api/graph/infer)을 시도한 시각 — 1회만. --retry 로 다시

  createdBy   User     @relation("PageCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  // database 종류일 때만 사용
  dbProperties DbProperty[]
  dbRows       DbRow[]      @relation("RowsOfDatabase")
  dbViews      DbView[]
  rowBacklink  DbRow?       @relation("RowContentPage")

  revisions PageRevision[]

  // 페이지 단위 권한 (격차 D3). 기본 inherit — 위로 올라가며 가장 가까운 결정자가 판정한다.
  // 판정 규칙 전체는 lib/pageAccess.ts 에 순수 함수로 있다(여기 스키마는 자리만 만든다).
  visibility Visibility  @default(inherit)
  grants     PageGrant[]

  @@index([workspaceId, parentId])
  @@index([projectId])
  @@index([workspaceId, inferTriedAt])
  // 검색 트라이그램 인덱스(격차 G1)를 **스키마에 선언해 둔다.**
  // 마이그레이션 20260808140000 에서 raw SQL 로만 만들었더니, 다음 `prisma migrate dev`
  // 가 "스키마에 없는 인덱스" 로 보고 조용히 DROP 하는 diff 를 만들어 냈다(D3 작업 중 실제로 발생).
  // 선언해 두면 프리즈마가 자기 것으로 알아 더는 지우지 않는다.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Page_title_trgm_idx")
  @@index([markdown(ops: raw("gin_trgm_ops"))], type: Gin, map: "Page_markdown_trgm_idx")
}

// 접근 범위 (D3): inherit = 위(부모·프로젝트·워크스페이스 역할)를 따른다 / restricted = 부여받은 사람만.
enum Visibility {
  inherit
  restricted
}

enum GrantLevel {
  view
  edit
}

// ---------- HTML 퍼블리시 (초대 게스트 전용) ----------
// 업로드한 HTML 번들을 /s/<slug> 로 공개하되, SiteInvite 이메일로 로그인한 사람만 본다.
// 파일은 DATA_DIR/sites/<siteId>/v<n>/ 에 있고 여기엔 메타만 둔다. 격리·토큰은 lib/sites/*.
enum SiteStatus {
  active
  disabled
}

model PublishedSite {
  id             String     @id @default(cuid())
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId    String
  project        Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId      String?
  slug           String     @unique
  title          String
  currentVersion Int        @default(1)
  status         SiteStatus @default(active)
  createdBy      User       @relation("SiteCreatedBy", fields: [createdById], references: [id])
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  // 페이지의 상대경로 fetch('api/..') 를 넘길 로컬 서버(루프백만 — lib/sites/apiProxy). null = 프록시 없음.
  apiUpstream    String?

  invites  SiteInvite[]
  versions SiteVersion[]
  accesses SiteAccess[]
  intake   SiteIntakeEntry[]
  aliases  SiteSlugAlias[]

  @@index([workspaceId])
}

// 사이트의 옛 주소(슬러그). 슬러그를 바꾸면 이전 값이 여기 남고, /s/<옛 슬러그>/… 는
// 같은 하위 경로를 붙여 새 슬러그로 308 한다(app/s/[slug]/[[...path]]/page.tsx).
// 유일성은 PublishedSite.slug 와 **합쳐서** 본다(lib/sites/slug) — DB 는 각 테이블 안만 막는다.
model SiteSlugAlias {
  id        String        @id @default(cuid())
  slug      String        @unique
  site      PublishedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  createdAt DateTime      @default(now())

  @@index([siteId])
}

// 인테이크 — 초대 게스트(외주사)가 퍼블리시 페이지의 폼으로 보낸 계정 정보.
// 평문으로 남는 것은 `service`(항목 이름표)뿐이고, 입력값은 전부 `secret` 하나에
// AES-256-GCM(SITE_INTAKE_KEY 파생 키)으로 묶어 넣는다 — lib/sites/intakeCrypto.
// 게스트는 쓰기만 할 수 있고(POST /api/site-intake), 읽기·삭제는 워크스페이스 멤버만.
model SiteIntakeEntry {
  id                String        @id @default(cuid())
  site              PublishedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId            String
  service           String // 비밀이 아니다 — 목록에 그대로 보여준다
  fieldCount        Int
  secret            String // "v1:iv:tag:ct" — fields 배열 JSON 의 암호문
  submittedBy       String // /pub 프록시가 판정한 열람자 이메일(소문자)
  submittedByMember Boolean
  createdAt         DateTime      @default(now())
  revealCount       Int           @default(0)
  lastRevealedAt    DateTime?

  @@index([siteId, createdAt])
}

model SiteInvite {
  id           String        @id @default(cuid())
  site         PublishedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId       String
  email        String // 소문자·trim 정규화 후 저장(lib/sites/access.normalizeEmail)
  createdById  String?
  createdAt    DateTime      @default(now())
  lastAccessAt DateTime?

  @@unique([siteId, email])
  @@index([email])
}

// 접근 이력 — 셸(/s/<slug>)을 연 기록. 같은 계정이 10분 안에 다시 열면 남기지 않는다(새로고침 소음).
// /pub 에셋 요청은 기록하지 않는다(한 번 열 때 수십 건). IP·UA 는 저장하지 않는다 — 누가 언제 봤는지만 필요하다.
model SiteAccess {
  id        String        @id @default(cuid())
  site      PublishedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  email     String // 소문자 정규화
  member    Boolean // 워크스페이스 멤버(미리보기)였는가 — 초대 게스트와 구분해 보여준다
  version   Int
  createdAt DateTime      @default(now())

  @@index([siteId, createdAt])
  @@index([siteId, email, createdAt])
}

model SiteVersion {
  id          String        @id @default(cuid())
  site        PublishedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId      String
  version     Int
  fileCount   Int
  sizeBytes   Int
  createdById String?
  createdAt   DateTime      @default(now())

  @@unique([siteId, version])
}

// 페이지 부여 — 사용자 **또는** 팀 하나에 대해. (둘 다 비거나 둘 다 찬 행은 API 가 거절한다.)
model PageGrant {
  id          String     @id @default(cuid())
  page        Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId      String
  user        User?      @relation("PageGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String?
  level       GrantLevel @default(view)
  createdBy   User?      @relation("PageGrantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime   @default(now())

  @@unique([pageId, userId])
  @@unique([pageId, teamId])
  @@index([pageId])
}

// 프로젝트 부여 — 그 프로젝트에 속한 페이지 전체에 적용된다.
model ProjectGrant {
  id          String     @id @default(cuid())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  user        User?      @relation("ProjectGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String?
  level       GrantLevel @default(view)
  createdBy   User?      @relation("ProjectGrantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime   @default(now())

  @@unique([projectId, userId])
  @@unique([projectId, teamId])
  @@index([projectId])
}

// 문서 버전 히스토리 (W2): 본문 저장마다 그 시점 스냅샷을 적재 — 덮어쓰기 복구용.
model PageRevision {
  id        String   @id @default(cuid())
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  rev       Int // 저장 시점의 Page.rev (1부터)
  title     String
  markdown  String
  authorId  String? // requireCtx actor userId (사람/에이전트)
  createdAt DateTime @default(now())

  @@unique([pageId, rev])
  @@index([pageId, createdAt])
}

// ---------- 데이터베이스(노션 DB / 태스크 보드 공용) ----------
enum PropType {
  text
  number
  date
  select
  multiselect
  checkbox
  person
  relation
}

model DbProperty {
  id             String   @id @default(cuid())
  database       Page     @relation(fields: [databasePageId], references: [id], onDelete: Cascade)
  databasePageId String
  name           String
  type           PropType
  config         Json     @default("{}")
  position       Int      @default(0)
}

model DbRow {
  id             String   @id @default(cuid())
  database       Page     @relation("RowsOfDatabase", fields: [databasePageId], references: [id], onDelete: Cascade)
  databasePageId String
  props          Json     @default("{}") // { propId: value }
  contentPage    Page?    @relation("RowContentPage", fields: [contentPageId], references: [id])
  contentPageId  String?  @unique
  position       Int      @default(0)
  updatedById    String? // 마지막 변경 액터(사람/에이전트 User id) — W5 task-13
  createdById    String? // 만든 액터. updatedById 만 있고 이건 없어서 '만든 사람' 열을
  // 만들 수 없었다(격차 C3). 기존 행은 null 이다.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 서브아이템 (격차 C6) — 같은 보드 안의 부모 행. 자식은 부모 아래로 접힌다.
  // 별도 계층 테이블 대신 자기참조 한 컬럼으로 둔다(추가만 하는 마이그레이션).
  parent      DbRow?  @relation("RowSubItems", fields: [parentRowId], references: [id], onDelete: SetNull)
  parentRowId String?
  subItems    DbRow[] @relation("RowSubItems")

  checklist RowChecklistItem[]
  comments  RowComment[]

  @@index([databasePageId])
  @@index([parentRowId])
}

// ---------- 태스크(행) 체크리스트 / 댓글 ----------
model RowChecklistItem {
  id        String   @id @default(cuid())
  row       DbRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)
  rowId     String
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([rowId])
}

model RowComment {
  id        String   @id @default(cuid())
  row       DbRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)
  rowId     String
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  body      String
  createdAt DateTime @default(now())

  @@index([rowId])
}

enum ViewType {
  table
  kanban
  // 격차 C1 — 옵시디언·노션 대조에서 표·칸반 2종뿐이었다.
  gallery
  list
  calendar
  timeline
}

model DbView {
  id             String   @id @default(cuid())
  database       Page     @relation(fields: [databasePageId], references: [id], onDelete: Cascade)
  databasePageId String
  name           String   @default("Default")
  type           ViewType @default(table)
  config         Json     @default("{}") // { filters, sort, groupBy }
  position       Int      @default(0)
}

// ---------- 슬랙 ----------
model SlackInstall {
  id               String    @id @default(cuid())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId      String    @unique
  teamId           String
  botTokenEnc      String // 암호화 저장
  defaultChannelId String?
  createdAt        DateTime  @default(now())
}

enum NotifEvent {
  task_created
  task_status
  task_assigned
  task_due
  comment_added
  doc_saved
  weekly_digest // 프로젝트 주간 다이제스트(F6) — 워커·POST /api/digest 가 fireNotif 로 보낸다
}

enum NotifTarget {
  channel
  dm
}

model NotifRule {
  id          String      @id @default(cuid())
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  event       NotifEvent
  target      NotifTarget
  targetId    String // channelId 또는 userId
  // 프로젝트를 지우면 이 알림규칙의 projectId 가 남아 매칭에서 조용히 빠졌다
  // (레슨은 컨텍스트 주입에서 사라졌다 — 전수조사 D17). SetNull 로 정리한다.
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String? // 프로젝트 스코프(null=전역 기본)
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
}

// ---------- 알림 발송 내역 (슬랙 등 chat.postMessage 로그) ----------
model NotifLog {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  channel     String // "#qa-알림" 또는 대상
  text        String
  kind        String    @default("manual") // manual | approval | reminder | test | notification | due_marker | digest | digest_marker
  // (앞의 넷만 적혀 있어 실제로 쓰이는 뒤 둘이 누락돼 있었다 — D17)
  state       String // sent | failed
  error       String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// ---------- 승인/컨펌 (슬랙 인터랙티브) ----------
enum ApprovalStatus {
  pending
  approved
  rejected
  additional
}

enum ApprovalKind {
  general
  status
  triage
  doc
  project
  deploy
}

model Approval {
  id           String         @id @default(cuid())
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String
  title        String
  body         String
  kind         ApprovalKind   @default(general)
  highRisk     Boolean        @default(false)
  status       ApprovalStatus @default(pending)
  responseText String? // 추가요청 내용 / 거부 사유
  slackChannel String? // 발송 채널
  slackTs      String? // 발송 메시지 ts (chat.update 용)
  respondedBy  String? // 슬랙 user id
  createdBy    String? // 요청자 userId
  // 프로젝트를 지우면 이 승인의 projectId 가 남아 매칭에서 조용히 빠졌다
  // (레슨은 컨텍스트 주입에서 사라졌다 — 전수조사 D17). SetNull 로 정리한다.
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId    String? // 연결 프로젝트(선택)
  createdAt    DateTime       @default(now())
  respondedAt  DateTime?

  @@index([workspaceId, status])
}

// ---------- 문서 허브: 결정(decisions) ----------
enum DecisionStatus {
  proposed
  accepted
  superseded
}

model Decision {
  id          String         @id @default(cuid())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  title       String
  context     String? // 배경/맥락
  decision    String? // 결정 내용
  status      DecisionStatus @default(accepted)
  decidedAt   DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([workspaceId])
  @@index([projectId])
  // 검색 트라이그램 인덱스(G1) — Page 와 같은 이유로 스키마에 선언해 둔다.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Decision_title_trgm_idx")
  @@index([decision(ops: raw("gin_trgm_ops"))], type: Gin, map: "Decision_decision_trgm_idx")
}

// ---------- 문서 허브: 용어집(glossary) / 변경이력(changelog) — 제품 공통 ----------
model GlossaryTerm {
  id           String    @id @default(cuid())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String
  term         String
  definition   String
  sourcePageId String? // provenance: 추출 출처 문서 Page id(수동 추가면 null)
  createdAt    DateTime  @default(now())

  @@index([workspaceId])
}

model ChangelogEntry {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  // 제품(프로젝트)별 변경 이력 — null = 공용. 프로젝트 삭제 시 이력은 남기고 공용으로 돌린다.
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  version     String? // 예: v1.2.0
  title       String
  body        String?
  releasedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([workspaceId, projectId])
}

// ---------- 문서 허브: 리스크(risks) / QA — 프로젝트 문서 ----------
enum RiskSeverity {
  low
  medium
  high
}

enum RiskStatus {
  open
  mitigated
  closed
}

model Risk {
  id          String       @id @default(cuid())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  title       String
  description String?
  severity    RiskSeverity @default(medium)
  status      RiskStatus   @default(open)
  createdAt   DateTime     @default(now())

  @@index([workspaceId])
  @@index([projectId])
}

enum QaStatus {
  pending
  pass
  fail
}

model QaScenario {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  title       String
  steps       String?
  expected    String?
  status      QaStatus  @default(pending)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([projectId])
}

// ---------- 문서 허브: 데이터모델/DoD/온보딩 — 제품 공통 ----------
model Entity {
  id           String    @id @default(cuid())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String
  name         String
  description  String?
  fields       String? // 한 줄에 하나씩: "name: type — note"
  sourcePageId String? // provenance: 추출 출처 문서 Page id(수동 추가면 null)
  createdAt    DateTime  @default(now())

  @@index([workspaceId])
}

model DodItem {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  text        String
  done        Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model OnboardingStep {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  title       String
  body        String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

enum ScheduleKind {
  once
  cron
}

enum ScheduleStatus {
  active
  paused // @deprecated 죽은 값 — 어떤 코드도 이 상태를 만들거나 분기하지 않는다(D17)
  done
  failed
}

model Schedule {
  id               String         @id @default(cuid())
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId      String
  kind             ScheduleKind
  // 실제 형식(lib/schedule.ts): once = ISO datetime, cron = "daily:HH:MM" | "weekly:DDD:HH:MM".
  // 표준 cron 표현식이 아니고 UTC 도 아니다 — 서버 로컬 시각으로 해석한다(전수조사 D17).
  spec             String
  timezone         String? // @deprecated 미사용 — 코드에서 읽는 곳이 없다. 위 spec 이 서버 로컬 기준.
  template         Json           @default("{}")
  channelId        String
  slackScheduledId String? // chat.scheduleMessage 결과 id (취소용)
  status           ScheduleStatus @default(active)
  lastRunAt        DateTime?
  createdAt        DateTime       @default(now())
}

// ---------- Claude 세션 탐색기 (PLAN §9.1 / M4 준비) ----------
// 검색은 agentmemory 라이브 위임, 아래는 표시·복원력(:3111 다운 대비) 캐시.
enum SessionStatus {
  active
  ended
}

enum SessionItemKind {
  observation
  summary
  decision
  commit
  file_change
}

model ClaudeSession {
  id           String        @id @default(cuid())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String
  externalId   String // agentmemory sessionId
  project      String?
  cwd          String?
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  status       SessionStatus @default(active)
  lastSyncedAt DateTime?
  // 라이브 세션 보드(Console 4): SessionStart 훅이 저장소 정보를 보내고, 하트비트·잠금 CLI 가 lastSeenAt 을 갱신한다.
  branch       String?
  repo         String? // 본체 레포 이름(워크트리면 본체 기준)
  worktreePath String? // 연결된 워크트리일 때만(본체 체크아웃이면 null)
  lastSeenAt   DateTime?
  agentName    String? // 인입한 에이전트 토큰 이름(태스크 담당자와 같은 값)

  items SessionItem[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
  @@index([externalId])
  @@index([workspaceId, status])
}

// 공유 브랜치 푸시·배포 예약 잠금(Console 4). 이름당 한 행 — 만료(expiresAt<now)·해제(releasedAt)면 빈 잠금이다.
// 잡기는 조건부 updateMany(내 것·빈 것만)라 동시에 잡아도 한쪽만 이긴다. 푸시를 막지 않는다(pre-push 는 경고만).
model PushLock {
  id             String    @id @default(cuid())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId    String
  name           String // 예: banjang/develop · teamspace/main · deploy:teamspace
  holderName     String // 에이전트 토큰 이름(사람이면 사용자 이름)
  holderUserId   String? // 알림 수신자(토큰의 시스템 User)
  holderSession  String? // Claude 세션 id(있으면 같은 토큰의 다른 세션과 구분)
  cwd            String?
  branch         String?
  note           String?
  takenAt        DateTime  @default(now())
  expiresAt      DateTime
  releasedAt     DateTime?
  lastNotifiedAt DateTime? // pre-push 경고 알림 5분 1회 제한
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, name])
}

model SessionItem {
  id          String          @id @default(cuid())
  session     ClaudeSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  kind        SessionItemKind
  body        Json            @default("{}") // 관찰/요약/결정/커밋/파일변경 본문 캐시
  externalRef String? // agentmemory observation id 등 원본 참조
  createdAt   DateTime        @default(now())

  @@index([sessionId])
}

model WorkspaceRouteRule {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  cwdPrefix   String // cwd 접두사 또는 project glob → 워크스페이스 매핑
  projectId   String? // 매핑되는 프로젝트(선택) — /api/context?cwd= 프로젝트 스코프 해석용
  priority    Int       @default(0)

  @@index([workspaceId])
}

// 팀 레슨/작업규칙 (W3, 감사 mem-9): 개인 메모리의 feedback류 지식을 팀으로 승격하는 자리.
// /api/context 주입에 포함되어 모든 팀원·에이전트가 같은 규범을 받는다.
model Lesson {
  id          String   @id @default(cuid())
  workspaceId String
  // 프로젝트를 지우면 이 레슨의 projectId 가 남아 매칭에서 조용히 빠졌다
  // (레슨은 컨텍스트 주입에서 사라졌다 — 전수조사 D17). SetNull 로 정리한다.
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String? // null = 워크스페이스 전역(단, stack 이 있으면 스택 레슨)
  // 스택 레슨: 이 스택을 쓰는 프로젝트(Project.stack 에 포함)의 세션에만 주입. projectId 와 동시에 쓰지 않는다(API 가 거절).
  stack       String?
  // 개인 레슨: 이 사람(사람 User.id)과 그 사람이 발급한 에이전트 토큰의 세션에만 목록·조회·주입.
  // projectId·stack 과 함께 쓰지 않는다(범위는 하나 — API 가 거절).
  userId      String?
  // 주입 방식: required(필수 — 범위 안이면 항상 제목+요약, 예산 먼저) | default(제목 먼저, 남으면 요약)
  //           | ondemand(세션 시작 주입 제외 — 목록·검색·lesson_get 으로만)
  mode        String   @default("default")
  title       String
  body        String // 규칙 본문 (왜/어떻게 포함 권장)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, projectId])
  @@index([workspaceId, userId])
}

// ---------- LLM Job Queue (비동기 LLM 작업) ----------
model LlmJob {
  id             String    @id @default(cuid())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId    String
  kind           String // "feedback_classify" 등 잡 유형
  payload        Json // 호출자가 넘긴 원본(ref 포함)
  callbackUrl    String
  callbackSecret String? // 콜백 POST 의 Bearer 로 재전송
  status         String    @default("pending") // pending|done|failed
  attempts       Int       @default(0)
  result         Json?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId])
  @@index([status])
}

// 지식 승격 제안 큐 (메모리 완성 슬라이스): 세션에서 배운 것을 팀 지식으로 올리는 "제안+승인" 관문.
// approve 시 kind 에 따라 Lesson 또는 Decision(accepted) 이 생성된다.
model Proposal {
  id             String    @id @default(cuid())
  workspaceId    String
  kind           String // lesson | decision
  title          String
  body           String
  // 프로젝트를 지우면 이 제안의 projectId 가 남아 매칭에서 조용히 빠졌다
  // (레슨은 컨텍스트 주입에서 사라졌다 — 전수조사 D17). SetNull 로 정리한다.
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId      String?
  status         String    @default("pending") // pending | approved | rejected
  proposedById   String?
  proposedByName String
  reviewedById   String?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  @@index([workspaceId, status])
}

// 쓰기 멱등성 (W8 agent-11/18): Idempotency-Key 헤더 재요청 시 저장된 응답을 그대로 반환.
model IdempotencyRecord {
  key         String   @id // 클라이언트 제공 키 (워크스페이스 스코프 포함 해시)
  workspaceId String
  response    Json
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// 워커 하트비트 (W7 missed-6): tick 마다 upsert — /api/health 가 신선도를 판정.
model Heartbeat {
  id String   @id // "worker" 등 프로세스 이름
  at DateTime @updatedAt
}

// ---------- 협업 (W6) ----------

// 인앱 알림 인박스 (inv-4): 슬랙 발송과 별개로 수신자별 적재.
model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String // 수신자 (사람/에이전트 User)
  type        String // assigned | mention | approval | due | comment
  title       String
  link        String? // 앱 내 경로 (예: /p/<boardId>)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, userId, readAt])
}

// 활동 피드 = 경량 감사 로그 (inv-5, auth-7 부분).
model Activity {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String? // User id (사람/에이전트)
  actorName   String // 표시용 스냅샷 (탈퇴/회수 후에도 유지)
  verb        String // created | updated | deleted | restored | claimed | decided | invited | revoked ...
  targetType  String // doc | task | decision | approval | member | token | lesson
  targetId    String?
  targetTitle String
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// 문서 코멘트 (inv-9·doc-7). @멘션은 body 파싱으로 Notification 생성.
model PageComment {
  id        String   @id @default(cuid())
  pageId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  // 인라인 코멘트 (격차 D2) — 본문의 특정 문구에 달린다.
  // **글자 오프셋을 저장하지 않는다.** 문서가 편집되면 전부 어긋나기 때문에,
  // 인용문 + 앞뒤 문맥을 저장해 열 때마다 다시 찾는다(lib/anchor.ts).
  // 세 필드가 모두 비어 있으면 종전처럼 페이지 단위 코멘트다.
  anchorQuote  String?
  anchorPrefix String?
  anchorSuffix String?
  // 해결 표시 — 지우지 않고 접는다(무엇을 왜 고쳤는지가 남아야 한다).
  resolvedAt   DateTime?
  resolvedById String?

  @@index([pageId, createdAt])
}

// ---------- Auth.js (NextAuth) ----------
// OAuth(Account)/세션(Session)/검증토큰(VerificationToken) 표준 모델.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- 새 머신 curl|sh 페어링 (W1) ----------
model Pairing {
  code             String    @id
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId      String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  agentTokenId     String
  token            String
  tokenDeliveredAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([workspaceId])
}

// ---------- 지식 그래프: LLM 연관 간선(설계: 지식 그래프 확장(Graphify 차용)) ----------
// 결정적 간선(link·ref·mention·contains·pair)은 저장하지 않고 요청 시 계산한다(lib/knowledgeGraph).
// 여기는 LLM 이 고른 related 만 — 재계산 비용이 커서 저장한다. 읽을 때 양 끝 가시성으로 거른다.
model GraphEdge {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  fromId      String
  toId        String
  kind        String    @default("related")
  tag         String    @default("모호")
  reason      String?
  model       String?
  createdAt   DateTime  @default(now())

  @@unique([fromId, toId, kind])
  @@index([workspaceId])
}

// ---------- env 금고(설계: env 금고(Env Vault) 설계 · P1) ----------
// 값은 AES-256-GCM 암호문("v1:iv:tag:ct")으로만 저장한다. AAD = workspaceId:projectId:env:key
// (암호문을 다른 행으로 옮겨 붙이는 공격 차단). 마스터 키 = ENV_VAULT_KEY, 없으면 기능 비활성.
model EnvVar {
  id          String          @id @default(cuid())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  env         String // local | dev | prod | 자유 문자열
  key         String
  sealed      String
  keyVersion  Int             @default(1)
  version     Int             @default(1)
  valueLength Int             @default(0) // 화면 마스킹 길이용(값 자체는 아님)
  note        String?
  syncGroup   String? // 같은 값이어야 하는 키 묶음 이름(P3 불일치 경고용)
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    EnvVarVersion[]

  @@unique([projectId, env, key])
  @@index([workspaceId])
}

// 덮어쓰기 직전의 암호문 이력(되돌리기용). AAD 는 원 행과 같다.
model EnvVarVersion {
  id          String   @id @default(cuid())
  var         EnvVar   @relation(fields: [varId], references: [id], onDelete: Cascade)
  varId       String
  version     Int
  sealed      String
  updatedById String?
  createdAt   DateTime @default(now())

  @@index([varId])
}

// CLI 쓰기 작업(import)의 대기열 — 사람이 고위험 승인을 눌러야 적용된다.
// sealedPayload 는 vars 전체 JSON 을 AAD "op:<id>" 로 봉인한 것, 적용 후 비운다.
model EnvOp {
  id            String     @id @default(cuid())
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId   String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  env           String
  kind          String     @default("import") // import | push
  mode          String     @default("merge") // merge | overwrite | push
  // import: vars 전체 JSON · push: 요청 시 {versions}, claim 뒤 {digests}(값 아님) — 모두 AAD "op:<id>" 봉인
  sealedPayload String?
  keys          String[]   @default([])
  approvalId    String?
  // import: pending | applied | rejected | expired
  // push:   pending | claimed | done | partial | failed | rejected | expired
  status        String     @default("pending")
  target        EnvTarget? @relation(fields: [targetId], references: [id], onDelete: Cascade)
  targetId      String?
  createdById   String
  createdAt     DateTime   @default(now())
  expiresAt     DateTime
  appliedAt     DateTime?
  claimedAt     DateTime?

  @@index([workspaceId])
  @@index([approvalId])
  @@index([targetId])
}

// push 대상(로컬 .env·AWS SSM·Vercel·GitHub Actions). config·account 는 비밀이 아니다(경로·이름·기대 계정).
// 원격 반영은 CLI 가 로컬 로그인(aws·vercel·gh)으로 한다 — 서버는 클라우드 권한을 갖지 않는다.
// lastPushed = 키 → 반영 당시 값의 HMAC 지문(valueDigest). 읽을 수 없는 대상(Vercel sensitive·GHA)의 동기 판정용.
model EnvTarget {
  id           String    @id @default(cuid())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  env          String
  kind         String // dotenv | ssm | vercel | gha
  identity     String // 종류별 config 의 정체 문자열(같은 곳을 두 번 등록하지 않게)
  config       Json
  account      Json      @default("{}")
  lastPushedAt DateTime?
  lastPushed   Json?
  // P3a 드리프트 점검 결과 — 키 → match|differs|missing_remote|remote_only|present (값·해시 없음, CLI 가 비교)
  lastDriftAt  DateTime?
  lastDrift    Json?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ops          EnvOp[]

  @@unique([projectId, env, kind, identity])
  @@index([workspaceId])
}

// 값 접근 감사 로그. 키 이름만 남기고 값은 절대 남기지 않는다.
model EnvAccessLog {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  projectId   String?
  env         String?
  actorType   String // user | agent
  actorId     String
  actorName   String
  action      String // list | reveal | set | delete | import_request | import_apply | pull | push_request | push | push_result | target_add | target_update | target_delete | drift | drift_read | meta
  targetId    String?
  keys        String[]  @default([])
  viaFunnel   Boolean   @default(false)
  at          DateTime  @default(now())

  @@index([workspaceId, at])
}

enum DocType {
  design
  plan
  brief
  report
  handoff
  task_note
  other
}

/// 사람별 즐겨찾기(사이드바 ⭐). 페이지가 휴지통에 가도 행은 남기고 화면에서만 숨긴다.
model PageFavorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, pageId])
  @@index([userId, position])
}

/// 사람별 최근 열람(사이드바 🕘). 사람당 20개만 유지 — lib/favorites.recordVisit 이 정리한다.
model PageVisit {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  visitedAt DateTime @default(now())

  @@unique([userId, pageId])
  @@index([userId, visitedAt])
}

/// TeamSpace 자신의 LLM 호출 기록(lib/llm.ts 가 호출마다 1행, 기록 실패는 호출측에 영향 없음).
/// 프롬프트·응답 본문은 저장하지 않는다 — 기능·경로·모델·성패·시간·토큰만. 90일 뒤 정리(lib/aiRoutes/llmCalls.ts).
/// workspaceId 는 관계 없이 문자열만 둔다(워크스페이스 밖 호출도 남길 수 있고, 삭제 순서에 묶이지 않게).
model LlmCall {
  id           String   @id @default(cuid())
  workspaceId  String?
  feature      String // ask·clip·graph-infer·qa-extract … (호출측 라벨)
  provider     String // "api" | "cli" | "cache"(응답 캐시 적중 — 실제 호출 없음)
  model        String
  ok           Boolean
  errorKind    String? // no_key·http_429·timeout·not_installed·exit·empty·network …
  durationMs   Int
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

/// LLM 응답 캐시 — 같은 프롬프트(모델·system 포함)는 다시 부르지 않는다(A-5). 본문은 응답 텍스트만, 프롬프트는 해시만.
model LlmCache {
  id        String   @id @default(cuid())
  key       String   @unique // sha256(provider·model·system·prompt[·workspaceId]) — workspaceId 가 있으면 키에 섞는다
  workspaceId String? // 쓴 워크스페이스(없으면 서버 공용/구 행). 워크스페이스 삭제 시 deleteLlmCacheForWorkspace 로 정리
  feature   String
  model     String
  text      String
  createdAt DateTime @default(now())
  lastHitAt DateTime @default(now())

  @@index([lastHitAt])
  @@index([workspaceId])
}

/// 레슨 주입 기록(레슨 주입 점검 화면) — /api/context?compact=1(세션 훅 주입)마다 1행.
/// 레슨 본문은 저장하지 않는다 — 어떤 id 가 요약·제목만·'외 N개' 로 들어갔는지와 글자 수만. 90일 뒤 정리(lib/lessonInspect/log.ts).
/// workspaceId·projectId 는 관계 없이 문자열만 둔다(LlmCall 과 같은 이유 — 삭제 순서에 묶이지 않게).
model LessonInjection {
  id          String   @id @default(cuid())
  workspaceId String
  actorName   String? // 에이전트 토큰 이름 또는 사람 이름
  cwd         String?
  projectId   String? // cwd → route-rule 로 해석된 프로젝트(없으면 null)
  via         String // SessionStart | PostToolUse | unknown (훅이 &via= 로 보냄)
  mode        String   @default("compact") // compact(새 세션 ~9KB) | brief(이어가기·압축 ~2.5KB — 요약 없이 제목만)
  gistIds     String[] // 제목+요약으로 들어간 레슨
  titleIds    String[] // 제목만 들어간 레슨
  omittedIds  String[] // '외 N개' 로만 센 레슨
  chars       Int // 컨텍스트 전체 글자 수
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
}

/// 레슨 전문 조회 기록 — 에이전트가 GET /api/lessons/<id>(MCP lesson_get) 로 읽을 때 1행. 90일 보관.
model LessonRead {
  id          String   @id @default(cuid())
  workspaceId String
  lessonId    String
  actorName   String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([lessonId])
}

/// 주간 지표 스냅샷(피드백 루프 ①) — 워커가 매주 1행. 비교는 CLI/API 가 한다.
model MetricSnapshot {
  id          String   @id @default(cuid())
  workspaceId String
  weekKey     String   // ISO 주 "2026-W41"
  data        Json
  createdAt   DateTime @default(now())

  @@unique([workspaceId, weekKey])
}
